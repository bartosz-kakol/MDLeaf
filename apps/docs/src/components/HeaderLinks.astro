---
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://mdleaf-app.pages.dev';
---

<a class="open-app" href={appUrl} target="_blank" rel="noopener">Open MDLeaf</a>
<Default />

<style>
  .open-app {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    border-radius: 0.4rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .open-app:hover {
    opacity: 0.9;
  }
</style>
